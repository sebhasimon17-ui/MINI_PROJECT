            <column caption='Average Cost for two' datatype='integer' name='[Average_Cost_for_two]' role='measure' type='quantitative' />
            <column caption='Estimated Revenue Index' datatype='integer' name='[Calculation_1296653299691526]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Average_Cost_for_two] * [Votes]' />
